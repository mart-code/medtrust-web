# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=medtrust
DATABASE_PASSWORD=medtrust_password
DATABASE_NAME=medtrust_db

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-...

# File Uploads (local for dev; switch to S3 for prod)
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# AWS S3 (optional)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@medtrust.com

# Frontend URL
CLIENT_URL=http://localhost:3000
